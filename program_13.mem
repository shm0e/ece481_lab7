// PC: assembly                        expected registers after writeback
C2 // 00 LDI R0,#2                      R0=02
CB // 01 LDI R1,#3                      R1=03
D5 // 02 LDI R2,#5                      R2=05
D9 // 03 LDI R3,#1                      R3=01
02 // 04 ADD R0,R1                      R0=05
36 // 05 SUB R2,R3                      R2=04
4C // 06 AND R1,R2                      R1=00
78 // 07 IOR R3,R0                      R3=05
24 // 08 SUB R0,R2                      R0=01
6C // 09 IOR R1,R2                      R1=04
16 // 10 ADD R2,R3                      R2=09
7C // 11 IOR R3,R2                      R3=0D
E0 // 12 HALT                           PC=0C
E0 // 13
E0 // 14
E0 // 15
